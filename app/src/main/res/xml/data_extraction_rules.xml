<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="ai-dj-model/" />
        <exclude domain="file" path="ai-dj-voice/" />
        <exclude domain="file" path="ai-dj-speaker/" />
        <exclude domain="sharedpref" path="app_updates.xml" />
        <exclude domain="external" path="Download/updates/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="file" path="ai-dj-model/" />
        <exclude domain="file" path="ai-dj-voice/" />
        <exclude domain="file" path="ai-dj-speaker/" />
        <exclude domain="sharedpref" path="app_updates.xml" />
        <exclude domain="external" path="Download/updates/" />
    </device-transfer>
</data-extraction-rules>
