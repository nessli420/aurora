lists/pl.27f88e5d6448461cae924a4a8d08ac52","attributes":{"artwork":{"bgColor":"cc9b4b","height":1080,"url":"https://is1-ssl.mzstatic.com/image/thumb/Features/v4/6e/cf/9c/6ecf9c16-8f6e-9b59-f01f-a108723b026f/fc6a0bc9-2302-4afd-9d48-40bf0a189d90.png/{w}x{h}SC.DN02.jpg?l=en-US","width":1080},"audioTraits":[],"curatorName":"Apple Music Hits","description":{"short":"This year, it was “So Easy (To Fall in Love)” with Olivia Dean.","standard":"Today’s Hits is home to the biggest songs in pop, hip-hop, R&B, and more. Here are the biggest hits anywhere and everywhere—and we wouldn’t dare talk 2026 hits without hailing the gloriously soulful voice of <b>Olivia Dean</b>. The London native’s late-2025 album <i>The Art of Loving</i> fully broke through in 2026, taking her from Sabrina Carpenter’s opening act at Madison Square Garden to hosting her own four-night run there in less than a year.\n\nDean’s <b>“Man I Need”</b> has, of course, been a daily fixture on Apple Music’s Daily Top 100 since it arrived in August 2025, and her warm, vulnerable songs centering love and friendship draw on 1960s soul and pop, with touches of Sade, Prince, and Lauryn Hill. That mix of timeless glamour and best-friend relatability made Dean a beacon of hope for her women listeners in particular."},"hasCollaboration":false,"isChart":false,"lastModifiedDate":"2026-11-09T15:21:20Z","name":"Today’s Hits: Best of 2026","playParams":{"id":"pl.27f88e5d6448461cae924a4a8d08ac52","kind":"playlist","versionHash":"39f487b8d501f46e283805bab47951b938bb24cbc910bc0461abb69e1cf3e396"},"playlistType":"editorial","supportsSing":false,"url":"https://music.apple.com/us/playlist/todays-hits-best-of-2026/pl.27f88e5d6448461cae924a4a8d08ac52"}}]}}}]}}}]}}}]}